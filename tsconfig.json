{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": true,

        /* Bundler mode */
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "esModuleInterop": true,
        "noEmit": true,

        /* Linting */
        "strict": true,

        "paths": {
            "@giro3d/piero": ["./packages/piero/src"], // to access root index file implicitly
            "@giro3d/piero/*": ["./packages/piero/src/*"],
            "@/*": ["./packages/piero/src/*"]
        }
    },
    "include": ["*.ts"],
    "references": [{ "path": "./tsconfig.node.json" }]
}
